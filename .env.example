# PostgreSQL connection string (Neon, Supabase, or local Postgres)
# Example (Neon): postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Default runtime URL — use postgres/superuser until RLS tests pass (bypasses RLS = safe rollback).
DATABASE_URL="postgresql://user:password@localhost:5432/gym?schema=public"

# Direct connection for migrations and seed (postgres superuser). Required for Supabase pooler setups.
DIRECT_URL="postgresql://user:password@localhost:5432/gym?schema=public"

# Row Level Security (optional — enable only after running migration + scripts/setup-gym-app-role.sql)
# USE_RLS_ROLE=false (default): app uses DATABASE_URL (postgres bypasses RLS).
# USE_RLS_ROLE=true: app uses DATABASE_URL_RLS (gym_app role, RLS enforced).
USE_RLS_ROLE="false"
# Direct connection as gym_app (port 5432 — not the Supabase pooler):
# postgresql://gym_app:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL_RLS=""

# NextAuth / Auth.js
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: only needed if auto-detection fails (e.g. behind a proxy)
# AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"

# Public site URL (portal login links for staff to share)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Member portal — Google OAuth (separate from staff Credentials login)
# Redirect URI in Google Cloud Console:
#   http://localhost:3000/api/member-auth/callback/google
#   https://YOUR_PRODUCTION_HOST/api/member-auth/callback/google
MEMBER_AUTH_GOOGLE_CLIENT_ID=""
MEMBER_AUTH_GOOGLE_CLIENT_SECRET=""

# Initial owner account created by `npm run db:seed` (attached to Gym #1)
SEED_OWNER_NAME="Gym Owner"
SEED_OWNER_EMAIL="owner@gym.test"
SEED_OWNER_PASSWORD="ChangeMe123!"

# Platform-level super-admin account created by `npm run db:seed` (no gym;
# used to provision new gyms/owners from /admin)
SEED_SUPERADMIN_NAME="Platform Admin"
SEED_SUPERADMIN_EMAIL="admin@platform.test"
SEED_SUPERADMIN_PASSWORD="ChangeMeAdmin123!"

# Fast2SMS (SMS notifications). Leave unset to disable SMS sending.
# https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=""

# Resend (email notifications + receipt attachment). Leave unset to disable email sending.
# https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Gym Receipts <receipts@yourdomain.com>"

# Supabase Storage (gym logo upload). Uses the same Supabase project as the database.
# Project URL: Settings -> API -> Project URL
# Service role key: Settings -> API -> service_role secret (server-side only, never expose to the client)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="gym-assets"
