// Gym Management App - Prisma schema
// Multi-tenant model: every gym-specific row is scoped to a Gym via gymId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  STAFF
}

enum DurationUnit {
  MONTHS
  DAYS
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum MemberGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  GENERAL_FITNESS
  STRENGTH_TRAINING
  ENDURANCE
}

enum LedgerTransactionType {
  INCOME
  EXPENSE
}

// A tenant. Every gym-scoped row belongs to exactly one Gym. memberSeq and
// receiptSeq are atomically incremented (via a single UPDATE ... RETURNING)
// to hand out per-gym sequential numbers without collisions.
model Gym {
  id                 String   @id @default(cuid())
  name               String
  slug               String?  @unique
  registrationToken  String   @unique @default(cuid())
  memberSeq          Int      @default(0)
  receiptSeq         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users         User[]
  members       Member[]
  packages      Package[]
  subscriptions Subscription[]
  payments      Payment[]
  receipts      Receipt[]
  profile       GymProfile?
  visitors      Visitor[]
  dietPlans     DietPlan[]
  workoutPlans  WorkoutPlan[]
  exercises     Exercise[]
  employees     Employee[]
  gymEvents     GymEvent[]
  ledgerTransactions LedgerTransaction[]
}

// Gym staff accounts. gymId is null only for SUPER_ADMIN (platform-level,
// not tied to any tenant). The first per-tenant OWNER is created via the
// super-admin gym provisioning flow (or the seed script for Gym #1).
model User {
  id           String   @id @default(cuid())
  gymId        String?
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym                  Gym?           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdSubscriptions Subscription[] @relation("SubscriptionCreatedBy")
  recordedPayments     Payment[]      @relation("PaymentRecordedBy")
  trainedMembers       Member[]       @relation("MemberTrainer")
  ledgerTransactions   LedgerTransaction[] @relation("LedgerCreatedBy")

  @@index([gymId])
}

// Membership packages (name, price, duration).
model Package {
  id            String       @id @default(cuid())
  gymId         String
  name          String
  price         Decimal      @db.Decimal(10, 2)
  durationValue Int
  durationUnit  DurationUnit @default(MONTHS)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([gymId])
}

model Member {
  id           String   @id @default(cuid())
  gymId        String
  memberNumber Int
  name         String
  phone        String
  email        String?
  photoUrl     String?
  gender       MemberGender @default(PREFER_NOT_TO_SAY)
  notes        String?
  isPt         Boolean      @default(false)
  trainerId    String?
  membershipPolicyAgreedText String?   @db.Text
  membershipPolicyAgreedAt   DateTime?
  portalEnabledAt            DateTime?
  ageYears                   Int?
  heightCm                   Int?
  weightKg                   Decimal?  @db.Decimal(5, 1)
  fitnessGoal                FitnessGoal?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer       User?          @relation("MemberTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  payments      Payment[]
  dietPlan      DietPlan?
  workoutPlan   WorkoutPlan?

  @@unique([gymId, memberNumber])
  @@index([gymId, name])
  @@index([gymId, isPt])
  @@index([trainerId])
}

enum VisitorStatus {
  pending
  converted
}

enum VisitorSource {
  walk_in
  qr_registration
}

// Walk-in / trial visit log — not tied to packages or subscriptions.
model Visitor {
  id        String         @id @default(cuid())
  gymId     String
  name      String
  phone     String
  email     String?
  gender    MemberGender?
  visitDate DateTime       @db.Date
  notes     String?
  status    VisitorStatus  @default(pending)
  source    VisitorSource  @default(walk_in)
  membershipPolicyAgreedText String?   @db.Text
  membershipPolicyAgreedAt   DateTime?
  fitnessGoal                FitnessGoal?
  ageYears                   Int?
  heightCm                   Int?
  weightKg                   Decimal?  @db.Decimal(5, 1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, visitDate])
  @@index([gymId, name])
  @@index([gymId, status])
  @@index([gymId, source, status])
}

// HR roster — people who work at the gym (not app login accounts; see User).
model Employee {
  id          String    @id @default(cuid())
  gymId       String
  name        String
  phone       String
  position    String
  joiningDate DateTime  @db.Date
  salary      Decimal?  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, name])
}

model GymEvent {
  id          String   @id @default(cuid())
  gymId       String
  title       String
  eventDate   DateTime @db.Date
  location    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, eventDate])
}

// Manual business income/expense (rent, salary, etc.) — separate from member Payment rows.
model LedgerTransaction {
  id          String                @id @default(cuid())
  gymId       String
  type        LedgerTransactionType
  category    String
  amount      Decimal               @db.Decimal(12, 2)
  occurredOn  DateTime              @db.Date
  note        String?
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  gym       Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([gymId, occurredOn])
  @@index([gymId, type])
}

enum WorkoutLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MuscleGroup {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum ExerciseTrackingType {
  WEIGHTED
  TIME
  BODYWEIGHT
}

// Per-gym exercise library (seeded defaults + staff custom entries).
model Exercise {
  id                 String       @id @default(cuid())
  gymId              String
  name               String
  muscleGroup        MuscleGroup
  defaultSets        Int?
  defaultReps        String?
  defaultTempo       String?
  defaultRestSeconds Int?
  trackingType       ExerciseTrackingType @default(WEIGHTED)
  isSeeded           Boolean              @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  gym                 Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  workoutPlanExercises WorkoutPlanExercise[]

  @@unique([gymId, name])
  @@index([gymId, muscleGroup])
}

// One active training plan per member (no history).
model WorkoutPlan {
  id              String        @id @default(cuid())
  gymId           String
  memberId        String        @unique
  title           String
  durationWeeks   Int?
  focusGoal       String?       @db.Text
  level           WorkoutLevel?
  weeklySchedule  String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  gym       Gym                   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  exercises WorkoutPlanExercise[]
  sessions  WorkoutSession[]

  @@unique([gymId, memberId])
  @@index([gymId])
}

// An exercise line item within a member's workout plan.
model WorkoutPlanExercise {
  id              String   @id @default(cuid())
  gymId           String
  workoutPlanId   String
  exerciseId      String?
  customName      String?
  sortOrder       Int
  targetSets      Int
  targetReps      String
  tempo           String?
  restSeconds         Int?
  targetWeightKg      Decimal?              @db.Decimal(6, 2)
  trackingTypeOverride ExerciseTrackingType?
  createdAt           DateTime              @default(now())
  updatedAt       DateTime @updatedAt

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sessionExercises WorkoutSessionExercise[]

  @@index([workoutPlanId, sortOrder])
  @@index([gymId])
  @@index([exerciseId])
}

// A member's logged workout visit.
model WorkoutSession {
  id              String               @id @default(cuid())
  gymId           String
  memberId        String
  workoutPlanId   String
  status          WorkoutSessionStatus   @default(IN_PROGRESS)
  startedAt       DateTime             @default(now())
  completedAt     DateTime?
  durationSeconds Int?

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises   WorkoutSessionExercise[]

  @@index([gymId, memberId, status])
  @@index([workoutPlanId])
}

// An exercise performed during a session.
model WorkoutSessionExercise {
  id                    String   @id @default(cuid())
  gymId                 String
  workoutSessionId      String
  workoutPlanExerciseId String
  sortOrder             Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  session      WorkoutSession      @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  planExercise WorkoutPlanExercise @relation(fields: [workoutPlanExerciseId], references: [id], onDelete: Cascade)
  sets         WorkoutSetLog[]

  @@index([workoutSessionId, sortOrder])
  @@index([gymId])
  @@index([workoutPlanExerciseId])
}

// Per-set weight or duration logged by the member.
model WorkoutSetLog {
  id                   String   @id @default(cuid())
  gymId                String
  sessionExerciseId    String
  setNumber            Int
  weightKg             Decimal? @db.Decimal(6, 2)
  durationSeconds      Int?
  loggedAt             DateTime @default(now())

  sessionExercise WorkoutSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@unique([sessionExerciseId, setNumber])
  @@index([gymId])
}

// One active nutrition plan per member (no history).
model DietPlan {
  id             String   @id @default(cuid())
  gymId          String
  memberId       String   @unique
  title          String
  caloriesPerDay Int
  mealPlan       String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([gymId, memberId])
  @@index([gymId])
}

// A single billing cycle: member holds a package from startDate to endDate.
model Subscription {
  id              String   @id @default(cuid())
  gymId           String
  memberId        String
  packageId       String
  startDate       DateTime
  endDate         DateTime
  priceAtPurchase Decimal  @db.Decimal(10, 2)
  createdById     String?
  createdAt       DateTime @default(now())

  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@index([gymId])
  @@index([memberId])
  @@index([packageId])
  @@index([createdById])
  @@index([endDate])
}

// A manually-recorded payment collected in person.
model Payment {
  id             String        @id @default(cuid())
  gymId          String
  memberId       String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(CASH)
  paidAt         DateTime      @default(now())
  note           String?
  recordedById   String?
  createdAt      DateTime      @default(now())

  gym          Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  receipt      Receipt?

  @@index([gymId])
  @@index([memberId])
  @@index([paidAt])
  @@index([subscriptionId])
  @@index([recordedById])
}

// Gym profile / branding shown on receipts. One row per gym.
model GymProfile {
  id               String   @id @default(cuid())
  gymId            String   @unique
  name             String   @default("My Gym")
  logoUrl          String?
  address          String?
  phone            String?
  ownerNotifyPhone String?
  ownerNotifyEmail String?
  membershipPolicyText String? @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

// Immutable snapshot of a payment receipt, so past receipts stay stable even
// if the gym profile, member, or package details change later. The PDF is
// regenerated on demand from this data rather than stored as a file.
// `number` is a per-gym sequential number (see Gym.receiptSeq), not a global
// autoincrement, so each tenant's receipts start their own numbering.
model Receipt {
  id        String   @id @default(cuid())
  gymId     String
  number    Int
  paymentId String   @unique
  createdAt DateTime @default(now())

  gymName    String
  gymAddress String?
  gymPhone   String?
  gymLogoUrl String?

  memberId    String
  memberName  String
  memberPhone String
  memberEmail String?

  packageName String?
  amount      Decimal       @db.Decimal(10, 2)
  amountOwed  Decimal?      @db.Decimal(10, 2)
  balanceAfter Decimal?     @db.Decimal(10, 2)
  method      PaymentMethod
  paidAt      DateTime
  periodStart DateTime?
  periodEnd   DateTime?

  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([gymId, number])
  @@index([memberId])
}
